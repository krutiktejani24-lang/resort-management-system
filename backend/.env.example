# Database (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/resort_db"

# Only needed once, while running `npm run db:migrate-data` to copy
# real data over from the old Postgres database. Safe to remove after.
# SOURCE_DATABASE_URL="postgresql://user:password@old-host:5432/resort_db"

# Auth
JWT_SECRET="replace-with-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=8000
BACKEND_URL="https://your-api-domain.com"
NODE_ENV=production

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="Mango Tree Resort <your-email@gmail.com>"

# Frontend URL (for CORS + email links)
FRONTEND_URL="https://your-frontend-domain.com"

# Public base URL (used for invoice links)
BASE_URL="https://your-api-domain.com"
