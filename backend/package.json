{
  "name": "resort-backend",
  "version": "1.0.0",
  "description": "Luxury Resort Management Platform Backend",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "build": "prisma generate",
    "start": "node src/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node src/utils/seed.js",
    "db:studio": "prisma studio",
    "db:generate-legacy": "prisma generate --schema=prisma/legacy-postgres/schema.prisma",
    "db:migrate-data": "node scripts/migrate-postgres-to-mysql.js"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "fs-extra": "^10.1.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.19.1",
    "prisma": "^6.15.0",
    "puppeteer": "^25.3.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "slug": "^9.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
