// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  firstName    String
  lastName     String
  phone        String?
  role         Role          @default(CUSTOMER)
  avatar       String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[] @relation("TransactionCreator")

  bookings    Booking[]
  reviews     Review[]
  leads       Lead[]
  ActivityLog ActivityLog[]

  @@map("users")
}

model RoomCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rooms Room[]

  @@map("room_categories")
}

model Room {
  id               String     @id @default(uuid())
  name             String
  slug             String     @unique
  description      String     @db.Text
  shortDescription String?
  categoryId       String
  pricePerNight    Decimal    @db.Decimal(12, 2)
  capacity         Int
  bedType          String
  size             Float?
  floor            Int?
  roomNumber       String     @unique
  status           RoomStatus @default(AVAILABLE)
  amenities        Json
  images           Json
  featured         Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  category RoomCategory @relation(fields: [categoryId], references: [id])
  bookings Booking[]
  reviews  Review[]

  @@map("rooms")
}

model Booking {
  id              String        @id @default(uuid())
  bookingNumber   String        @unique
  userId          String
  roomId          String
  checkIn         DateTime
  checkOut        DateTime
  adults          Int           @default(1)
  children        Int           @default(0)
  totalNights     Int
  pricePerNight   Decimal       @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  finalAmount     Decimal       @db.Decimal(12, 2)
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  specialRequests String? @db.Text
  guestName       String
  guestEmail      String
  guestPhone      String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  invoiceNumber String? @unique
  invoicePdfUrl String?
  invoiceSent   Boolean @default(false)

  createdBy String?
  updatedBy String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  transaction Transaction?

  @@index([status])
  @@index([paymentStatus])
  @@index([checkIn])
  @@index([checkOut])
  @@index([roomId])
  @@index([userId])
  @@map("bookings")
}

model Review {
  id         String   @id @default(uuid())
  userId     String
  roomId     String
  bookingId  String?
  rating     Int
  title      String?
  comment    String   @db.Text
  isApproved Boolean  @default(false)
  response   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@map("reviews")
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String   @db.Text
  content     String   @db.Text
  coverImage  String?
  author      String
  tags        Json
  isPublished Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blog_posts")
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  description String?  @db.Text
  url         String
  thumbnail   String?
  type        String   @default("image")
  category    String
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("gallery_items")
}

model Lead {
  id         String     @id @default(uuid())
  userId     String?
  name       String
  email      String
  phone      String?
  subject    String
  message    String     @db.Text
  source     String     @default("contact_form")
  status     LeadStatus @default(NEW)
  notes      String?
  assignedTo String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@map("leads")
}

model Amenity {
  id          String   @id @default(uuid())
  name        String
  icon        String?
  description String?
  category    String
  createdAt   DateTime @default(now())

  @@map("amenities")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Transaction {
  id String @id @default(uuid())

  bookingId String? @unique

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  invoiceNumber String   @unique
  date          DateTime @default(now())

  guestName  String
  guestPhone String?
  guestEmail String?

  roomNumber String?
  roomType   String?

  checkIn  DateTime?
  checkOut DateTime?
  nights   Int?

  paymentMode TransactionPaymentMode // CASH | Card | Online | UPI
  invoiceType InvoiceType

  subtotal      Decimal @db.Decimal(12, 2)
  gstAmount     Decimal @db.Decimal(12, 2)
  serviceCharge Decimal @default(0.00) @db.Decimal(12, 2)
  discount      Decimal @default(0) @db.Decimal(12, 2)

  totalAmount Decimal @db.Decimal(12, 2)

  notes String? @db.Text

  createdBy    String
  status       TransactionStatus @default(ACTIVE)
  refundAmount Decimal           @default(0.00) @db.Decimal(12, 2)
  refundReason String?
  refundDate   DateTime?
  isDeleted    Boolean           @default(false)
  deletedAt    DateTime?

  invoicePdfUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User @relation(name: "TransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  items TransactionItem[]

  @@index([date])
  @@index([paymentMode])
  @@index([createdBy])
  @@index([bookingId])
  @@index([status])
  @@index([guestName])
  @@map("transactions")
}

model TransactionItem {
  id String @id @default(uuid())

  transactionId String

  category    String
  description String  @db.Text

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  gstPercent Decimal @db.Decimal(5, 2)
  total      Decimal @db.Decimal(12, 2)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  invoicePrinted Boolean @default(false)
  whatsappSent   Boolean @default(false)
  emailSent      Boolean @default(false)

  @@map("transaction_items")
}

enum TransactionPaymentMode {
  CASH
  CARD
  ONLINE
  UPI
}

enum InvoiceType {
  GST
}

enum TransactionStatus {
  ACTIVE
  CANCELLED
  REFUNDED
  FAILED
  PARTIAL_REFUND
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

model ActivityLog {
  id String @id @default(uuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action String

  module String

  description String @db.Text

  createdAt DateTime @default(now())

  @@map("activity_logs")
}
